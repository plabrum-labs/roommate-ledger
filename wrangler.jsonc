{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roommate-ledger",
  "account_id": "42ea0d21baf84d2a10e66a9ff0a421cc",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request goes through the Worker: the MCP host must serve only /mcp, never the SPA.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roommate-ledger",
      // Terraform owns the database (infra/d1.tf); this is `terraform output d1_database_id`.
      "database_id": "b122f9ee-cb8d-42f4-bb1b-38c4dfc41c0c",
      "migrations_dir": "drizzle"
    }
  ],
  // Cloudflare Access protects this hostname (infra/access.tf). workers.dev and preview URLs are off so there is no
  // route to the Worker that skips Access.
  // The MCP server lives on its own host (its own Access app with Managed OAuth); the Worker serves only /mcp there.
  "routes": [
    { "pattern": "roommate-ledger.plabrum.com", "custom_domain": true },
    { "pattern": "mcp.roommate-ledger.plabrum.com", "custom_domain": true }
  ],
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "phil-labs.cloudflareaccess.com",
    // AUD of the main Access app (`terraform output access_aud`). /api/* must carry a valid assertion for it in production;
    // if it were blank, /api would fall back to edge-only Access protection.
    "CF_ACCESS_AUD": "27182b4590956a07fd7cdcb6592105c59ae0772387f979aa0a3a5141d63e1de0",
    // AUD of the MCP Access app (`terraform output mcp_access_aud`). While blank, /mcp answers 503.
    "MCP_ACCESS_AUD": "711015a29145c03a196c46f9da56aa532d775bdeab084267637c102504377e70"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
