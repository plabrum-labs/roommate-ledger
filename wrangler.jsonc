{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roommate-ledger",
  "account_id": "42ea0d21baf84d2a10e66a9ff0a421cc",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roommate-ledger",
      // Terraform owns the database (infra/d1.tf); this is `terraform output d1_database_id`.
      "database_id": "b122f9ee-cb8d-42f4-bb1b-38c4dfc41c0c",
      "migrations_dir": "drizzle"
    }
  ],
  // Cloudflare Access protects this hostname (infra/access.tf). workers.dev and preview URLs are off so there is no
  // route to the Worker that skips Access.
  "routes": [{ "pattern": "roommate-ledger.plabrum.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
